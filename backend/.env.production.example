# ==============================================================================
# Recraftr Backend Production Environment Template
# ==============================================================================
# Copy this file to .env on your production host and populate with real secrets.
# NEVER commit the real production .env file to version control.
# ==============================================================================

# Core Runtime Configuration
ENVIRONMENT=production
DEBUG=False
PORT=8000
HOST=127.0.0.1

# Production PostgreSQL Database (Supabase Transaction Pooler - Port 6543)
# Format: postgresql+asyncpg://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?ssl=require
DATABASE_URL=postgresql+asyncpg://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres?ssl=require

# Supabase Production Project API & Auth
SUPABASE_URL=https://yourprojectref.supabase.co
SUPABASE_ANON_KEY=your_production_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_production_supabase_service_role_key

# Secondary / Legacy Datastore (if required for migration or caching)
MONGO_URL=mongodb://127.0.0.1:27017
DB_NAME=recraftr_production

# Authentication Security (Generate using: openssl rand -hex 32)
JWT_SECRET=generate_at_least_32_bytes_random_hex_for_production_security

# Production AI Provider Credentials
GEMINI_API_KEY=your_production_google_gemini_api_key
GROQ_API_KEY=your_production_groq_api_key
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# Payment Gateway (Live PayMongo API Keys)
PAYMONGO_SECRET_KEY=sk_live_your_live_paymongo_secret_key
PAYMONGO_PUBLIC_KEY=pk_live_your_live_paymongo_public_key

# Production CORS Whitelist (Strict origins, comma-separated, no trailing slash)
CORS_ORIGINS=https://recraftr.com,https://www.recraftr.com,https://app.recraftr.com
