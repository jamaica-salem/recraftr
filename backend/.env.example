# ==============================================================================
# Recraftr Backend Environment Variables
# ==============================================================================

# Database (PostgreSQL / Supabase Transaction Pooler)
DATABASE_URL=postgresql+asyncpg://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?ssl=require

# Supabase API Configuration
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_public_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key

# Legacy MongoDB Connection (used during transition and migration script)
MONGO_URL=mongodb://localhost:27017
DB_NAME=recraftr

# Authentication (JWT Secret key - use at least 32 characters in production)
JWT_SECRET=your_super_secret_jwt_key_at_least_32_bytes

# AI Provider API Keys
GEMINI_API_KEY=your_google_gemini_api_key
GROQ_API_KEY=your_groq_api_key

# AI Default Models
GEMINI_MODEL=gemini-3.5-flash
GROQ_MODEL=openai/gpt-oss-120b

# CORS Configuration (comma-separated origins or * in development)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

